# ==============================================================================
# SalesSight AI - Environment Configuration Template (.env.example)
# Copy to .env and configure for local or cloud environments
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=production
DEBUG=false
RANDOM_SEED=42

# Backend REST API URL
# For local development: http://127.0.0.1:8000
# For Streamlit Community Cloud (pointing to Render): https://salessight-ai-backend.onrender.com
API_URL=http://127.0.0.1:8000
BACKEND_URL=http://127.0.0.1:8000

# Server Binding
HOST=0.0.0.0
PORT=8000

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/salessight.log
